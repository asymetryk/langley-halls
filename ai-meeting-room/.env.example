# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room
MEETING_ROOM_NAME=ai-meeting-room

# ElevenLabs (fallback if Baserow unavailable)
ELEVENLABS_API_KEY=

# Per-agent ElevenLabs ConvAI agent IDs (create via setup script or dashboard)
ELEVENLABS_AGENT_ID_FRED=
ELEVENLABS_AGENT_ID_MISSY=
ELEVENLABS_AGENT_ID_ARCHITECT=
ELEVENLABS_AGENT_ID_PROJECT_ALPHA=

# Reasoning backend: mock | openai | anthropic (future)
REASONING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Custom LLM server (ElevenLabs agents point here)
REASONING_API_HOST=0.0.0.0
REASONING_API_PORT=8090
REASONING_API_PUBLIC_URL=https://your-tunnel.example.com

# Baserow secrets table
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_TOKEN=
BASEROW_SECRETS_TABLE_ID=
BASEROW_SECRET_NAME_FIELD=Name
BASEROW_SECRET_VALUE_FIELD=Value
ELEVENLABS_SECRET_NAME=elevenlabs_api_key
