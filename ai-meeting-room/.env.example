# --- Required for interactive demo (`main interactive` / `main demo`) ---
# LiveKit Cloud
LIVEKIT_URL=wss://langley-halls-4hci1cx8.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEETING_ROOM_NAME=ai-meeting-room

# ElevenLabs TTS (interactive). ConvAI scopes needed only if `main run` is revived.
ELEVENLABS_API_KEY=

# OmniRoute (interactive reasoning). Model id is not a secret.
OMNIROUTE_BASE_URL=https://omniroute-api.asymetryk.com
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=codex/gpt-5.6-sol

# --- ConvAI only (parked; `main run`). Not required for interactive. ---
# Filled automatically by scripts/bootstrap.py
ELEVENLABS_AGENT_ID_FRED=
ELEVENLABS_AGENT_ID_MISSY=
ELEVENLABS_AGENT_ID_ARCHITECT=
ELEVENLABS_AGENT_ID_PROJECT_ALPHA=

# --- Optional: Baserow secrets table (ElevenLabs key fallback) ---
# Self-hosted Pocket SoT. Database tokens 401 on /api/applications/ — expected.
# If BASEROW_SECRETS_TABLE_ID is unset, Baserow is skipped (not required).
# Pocket SoT table is 828 (columns: Name, Notes, Secret, Last modified).
# validate / interactive / demo read rows on that table only. Never commit BASEROW_API_TOKEN.
BASEROW_API_URL=https://baserow.tail21f530.ts.net
BASEROW_API_TOKEN=
BASEROW_SECRETS_TABLE_ID=828
BASEROW_SECRET_NAME_FIELD=Name
BASEROW_SECRET_VALUE_FIELD=Secret
# Row Name for Langley (there is no elevenlabs_api_key row)
ELEVENLABS_SECRET_NAME=elevenlabs langley halls

# --- Optional: interactive meeting tuning ---
INTERACTIVE_DEBOUNCE_SEC=1.2
INTERACTIVE_COOLDOWN_SEC=1.5
INTERACTIVE_MAX_REPLY_TOKENS=80
INTERACTIVE_DEFAULT_CHAIR=project_alpha
INTERACTIVE_EXCLUDED_AGENTS=fred
CONVERSATION_IDLE_SEC=60

# --- Optional: host dashboard (starts with interactive mode) ---
ROOM_CONTROL_HOST=127.0.0.1
ROOM_CONTROL_PORT=8092
ROOM_CONTROL_TOKEN=

# --- Optional: relay bridge (room ↔ Cursor thread) ---
RELAY_ENABLED=true
RELAY_DIR=relay
RELAY_FORWARD_MODE=relay
RELAY_CURSOR_POLL_SEC=1.0
# When true, OmniRoute speaks stub replies in-room (NOT the real Cursor agent).
CURSOR_AUTO_REPLY_IN_ROOM=false
# Public URL for join links when tunneling the dashboard (optional)
ROOM_CONTROL_PUBLIC_URL=
